// TestForge — Prisma schema
// SQLite untuk development out-of-the-box; portable ke PostgreSQL
// (ganti provider + DATABASE_URL sesuai PRD §5.1 untuk production).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  passwordHash    String
  role            String    @default("MEMBER") // ADMIN | MEMBER | VIEWER
  avatarUrl       String?
  organizationId  String?
  emailVerifiedAt DateTime? // AU-001: wajib verifikasi sebelum login
  onboardedAt     DateTime? // AU-006: penanda wizard onboarding selesai
  totpSecretEnc   String?   // F-20: crypto.ts-encrypted base32 TOTP secret; null = 2FA off
  totpEnabledAt   DateTime? // F-20: set only after the user proves one valid code
  createdAt       DateTime  @default(now())

  organization Organization?       @relation(fields: [organizationId], references: [id])
  tokens       VerificationToken[]
  invitesSent  Invitation[]

  memberships    ProjectMember[]
  createdProjects Project[]      @relation("ProjectCreator")
  assignedCases  TestCase[]      @relation("CaseAssignee")
  assignedResults TestRunResult[] @relation("ResultAssignee")
  createdRuns    TestRun[]       @relation("RunCreator")
  apiKeys        ApiKey[]
  auditLogs      AuditLog[]
  attachments    Attachment[]
  savedViews     SavedView[]
  caseRevisions  TestCaseRevision[] @relation("RevisionAuthor")
  createdPlans   TestPlan[]         @relation("PlanCreator")
  mutedCases     TestCase[]         @relation("CaseMutedBy")
  reviewingCases TestCase[]         @relation("CaseReviewer")
  comments       Comment[]          @relation("CommentAuthor")
  dashboards     Dashboard[]        @relation("DashboardCreator")
  shareLinks     ShareLink[]        @relation("ShareLinkCreator")
  reportSchedules ReportSchedule[]  @relation("ReportScheduleCreator")
  requirements    Requirement[]     @relation("RequirementCreator")
  recoveryCodes   TwoFactorRecoveryCode[]
  sessions        Session[]         @relation("SessionTester")
  assignedDefects Defect[]          @relation("DefectAssignee")
  createdDefects  Defect[]          @relation("DefectCreator")
  createdBaselines SuiteBaseline[]  @relation("BaselineCreator")
  publicShares    PublicShare[]     @relation("PublicShareCreator")
  lessonProgress  LessonProgress[]
  examAttempts    ExamAttempt[]
  certificates    Certificate[]
}

// F-20: single-use TOTP recovery codes. codeHash is the sha256 hex of the raw
// code, same recipe as ApiKey.keyHash — the raw code is shown once at enrollment
// and never stored. usedAt marks a spent code (single-use).
model TwoFactorRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  status      String   @default("ACTIVE") // ACTIVE | ARCHIVED
  // A-04: NORMAL | ACADEMY_SANDBOX. A sandbox is a real project — same tables,
  // same permissions, so every lesson can exercise the real product — but it is
  // the learner's scratch space, not their work, so the surfaces that list "my
  // projects" (dashboard, /projects, global search) filter it out. Identifying
  // it by a column rather than a slug prefix is what makes those filters
  // trustworthy; a prefix is a naming convention one rename away from breaking.
  kind        String   @default("NORMAL")
  caseCounter Int      @default(0) // untuk auto-generate TC-[SLUG]-[NUMBER]
  defectCounter Int    @default(0) // F-26: auto-generate DF-[SLUG]-[NUMBER]
  autoCreateEnvs Boolean @default(true) // F-19: auto-create an Environment from &env= on automation upload
  gatePolicyJson String? // L-02: CI quality gate policy (null = no gate → endpoint 404)
  createdById String
  createdAt   DateTime @default(now())

  createdBy  User            @relation("ProjectCreator", fields: [createdById], references: [id])
  members    ProjectMember[]
  suites     TestSuite[]
  cases      TestCase[]
  runs       TestRun[]
  milestones Milestone[]
  webhooks   Webhook[]
  attachments Attachment[]
  savedViews SavedView[]
  customFieldDefs CustomFieldDef[]
  sharedStepGroups SharedStepGroup[]
  notificationChannels NotificationChannel[]
  integrations Integration[]
  issueLinks   IssueLink[]
  configGroups ConfigGroup[]
  testPlans    TestPlan[]
  environments Environment[]
  comments     Comment[]
  resultStatusDefs ResultStatusDef[]
  dashboards   Dashboard[]
  reportSchedules ReportSchedule[]
  requirements Requirement[]
  badgeToken   BadgeToken?
  sessions     Session[]
  defects      Defect[]
  baselines    SuiteBaseline[]
  importMapping ImportColumnMapping?
  apiKeys      ApiKey[] // F-33: keys scoped to this project only
  publicShare  PublicShare? // F-38: portfolio mode
}

// F-38: public read-only project sharing ("portfolio mode"). One row per
// project; presence + enabled=true is what makes /public/<slug> resolve.
// Overview is always visible when enabled; other sections are per-column
// toggles so future sections are additive columns, not a JSON blob.
model PublicShare {
  id          String   @id @default(cuid())
  projectId   String   @unique
  enabled     Boolean  @default(true)
  showCases   Boolean  @default(true) // Test Cases browser + case detail
  // Runs/Reports default OFF: they are added after shares already existed, and
  // a schema default of true would publish execution history on every project
  // that is already public without its owner ever choosing to.
  showRuns    Boolean  @default(false) // run list — names + status tallies only
  showReports Boolean  @default(false) // aggregate quality metrics only
  indexable   Boolean  @default(false) // false => robots noindex
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("PublicShareCreator", fields: [createdById], references: [id])
}

// F-30: the CSV case-import column mapping a project settled on, so repeat
// imports from the same export tool don't need re-mapping every time. One
// row per project (upsert-only, never multiple named mappings).
model ImportColumnMapping {
  id         String   @id @default(cuid())
  projectId  String   @unique
  mappingJson String  @default("{}") // {targetField: sourceCsvHeader}
  updatedAt  DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// F-26: built-in defect tracker for teams without an external issue tracker
// (complements, not replaces, the F-07 Jira/GitHub/GitLab integration).
// `seq` is a per-project counter (Project.defectCounter), display DF-[SLUG]-[N].
model Defect {
  id          String   @id @default(cuid())
  projectId   String
  seq         Int
  title       String
  severity    String   @default("MEDIUM") // CRITICAL | HIGH | MEDIUM | LOW
  status      String   @default("OPEN")   // OPEN | CONFIRMED | FIXED | WONT_FIX | CLOSED
  bodyMd      String?
  assigneeId  String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee  User?        @relation("DefectAssignee", fields: [assigneeId], references: [id])
  createdBy User         @relation("DefectCreator", fields: [createdById], references: [id])
  links     DefectLink[]

  @@unique([projectId, seq])
}

// Polymorphic link from a defect to the case/result it was found on (same
// pattern as Attachment/IssueLink) — a defect may be linked from many results.
model DefectLink {
  id         String   @id @default(cuid())
  defectId   String
  entityType String // CASE | RESULT
  entityId   String
  createdAt  DateTime @default(now())

  defect Defect @relation(fields: [defectId], references: [id], onDelete: Cascade)

  @@unique([defectId, entityType, entityId])
  @@index([entityType, entityId])
}

// F-25: exploratory / session-based testing. A tester runs a timeboxed
// session against a charter and drops timestamped notes as they go; BUG and
// IDEA notes can later convert into a filed issue (F-07) or a draft case.
// Only the tester may add notes / end their own session (single-player,
// like a run executor); everyone in the project can read it.
model Session {
  id             String    @id @default(cuid())
  projectId      String
  charter        String
  timeboxMinutes Int       @default(30)
  status         String    @default("ACTIVE") // ACTIVE | ENDED
  testerId       String
  startedAt      DateTime  @default(now())
  endedAt        DateTime?

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tester  User          @relation("SessionTester", fields: [testerId], references: [id])
  notes   SessionNote[]

  @@index([projectId, status])
}

// kind: NOTE | BUG | QUESTION | IDEA. convertedType/convertedId record what a
// BUG ("ISSUE") or IDEA ("CASE") note turned into; null = not converted yet.
model SessionNote {
  id            String   @id @default(cuid())
  sessionId     String
  kind          String
  bodyMd        String
  convertedType String?
  convertedId   String?
  createdAt     DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

// F-18: requirements & traceability. A requirement is COVERED when it has at
// least one linked, non-deleted, non-deprecated case — derived, never stored
// as truth (status column only distinguishes OPEN vs OBSOLETE; COVERED is
// computed in lib/requirements.ts).
model Requirement {
  id            String   @id @default(cuid())
  projectId     String
  refId         String // "REQ-001" (auto) or an external key
  title         String
  descriptionMd String?
  sourceUrl     String?
  status        String   @default("OPEN") // OPEN | OBSOLETE (COVERED derived)
  createdById   String
  createdAt     DateTime @default(now())

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User              @relation("RequirementCreator", fields: [createdById], references: [id])
  cases     RequirementCase[]

  @@unique([projectId, refId])
}

model RequirementCase {
  requirementId String
  caseId        String

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  testCase    TestCase    @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@id([requirementId, caseId])
  @@index([caseId])
}

// F-17: custom dashboards — a named grid of report widgets per project.
model Dashboard {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  createdById String
  createdAt   DateTime @default(now())

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User              @relation("DashboardCreator", fields: [createdById], references: [id])
  widgets   DashboardWidget[]
}

// One widget on a dashboard. `type` picks the server component; layout is a
// cell rect on a 4-column CSS grid. configJson holds per-type settings
// (currently only textNote's {"text": "..."}).
model DashboardWidget {
  id          String @id @default(cuid())
  dashboardId String
  type        String // passRateTrend | statusPie | coverageBar | flakyList | runVelocity | textNote
  title       String?
  configJson  String @default("{}")
  x           Int    @default(0)
  y           Int    @default(0)
  w           Int    @default(2)
  h           Int    @default(1)

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
}

// F-17: public read-only share links. Polymorphic entityId (same pattern as
// Attachment) — a deleted run/dashboard just makes the link render 404.
// Token is 64 hex chars from crypto.randomBytes (unguessable); revocation is
// a soft flag so the audit trail keeps the row.
model ShareLink {
  id          String    @id @default(cuid())
  token       String    @unique
  entityType  String // RUN | DASHBOARD
  entityId    String
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  createdBy User @relation("ShareLinkCreator", fields: [createdById], references: [id])

  @@index([entityType, entityId])
}

// L-01: public quality badge. One row per project; the token IS the auth for
// /badge/<token>.svg (no session, no project data beyond the number). Revoke
// is a soft flag; re-enabling rotates `token` in place, so a revoked URL can
// never come back to life.
model BadgeToken {
  id        String    @id @default(cuid())
  projectId String    @unique
  token     String    @unique
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// F-17: scheduled email report summaries, sent by /api/cron/send-reports
// (same shared-secret pattern as the other cron routes). lastSentAt is the
// dedup guard — the cron route may be polled hourly but a schedule fires at
// most once per calendar day.
model ReportSchedule {
  id             String    @id @default(cuid())
  projectId      String
  cron           String // WEEKLY_MON | DAILY
  recipientsJson String    @default("[]") // ["qa-lead@acme.com", ...]
  kind           String    @default("SUMMARY")
  lastSentAt     DateTime?
  createdById    String
  createdAt      DateTime  @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("ReportScheduleCreator", fields: [createdById], references: [id])
}

// Outbound webhooks: POST a signed JSON payload to `url` when a subscribed event
// fires (best-effort, HMAC-SHA256 signature in X-TestForge-Signature).
model Webhook {
  id        String   @id @default(cuid())
  projectId String
  url       String
  secret    String // used to sign deliveries
  events    String // comma-separated event names (see lib/webhooks)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// F-01: file attachments on test cases & run results. Files live on disk under
// TF_UPLOAD_DIR (Docker: /data/uploads); rows are deduped per project by sha256
// (same content → same storageKey, file stored once). See src/lib/storage.ts.
model Attachment {
  id         String   @id @default(cuid())
  projectId  String
  uploaderId String
  entityType String   // "CASE" | "RESULT" | "SESSION_NOTE" (extensible: COMMENT, ...)
  entityId   String
  filename   String   // original name, sanitized
  mimeType   String
  sizeBytes  Int
  sha256     String
  storageKey String   // relative path inside TF_UPLOAD_DIR, never absolute
  createdAt  DateTime @default(now())

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader User    @relation(fields: [uploaderId], references: [id])

  @@index([entityType, entityId])
  @@index([projectId, sha256])
}

// F-04: reusable step blocks ("Log in as admin"). A case references a group
// via a {shared: <id>} item inside its stepsJson; consumers expand at render
// time (src/lib/steps.ts), so editing a group updates every referencing case.
// Deletion is hard but only allowed while nothing references the group.
model SharedStepGroup {
  id        String   @id @default(cuid())
  projectId String
  title     String
  stepsJson String   @default("[]") // InlineStep[] = [{action, expected}]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// F-06: a configuration axis for test plans ("Browser", "OS"). A plan picks
// options across groups and gets one run per combination.
model ConfigGroup {
  id        String @id @default(cuid())
  projectId String
  name      String // "Browser"
  order     Int    @default(0)

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  options ConfigOption[]

  @@unique([projectId, name])
}

model ConfigOption {
  id      String @id @default(cuid())
  groupId String
  name    String // "Chrome"
  order   Int    @default(0)

  group ConfigGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, name])
}

// F-06: a Test Plan bundles the runs generated from one case selection × a
// configuration matrix, with aggregate progress across its child runs.
model TestPlan {
  id          String    @id @default(cuid())
  projectId   String
  name        String
  description String?
  status      String    @default("ACTIVE") // ACTIVE | COMPLETED
  milestoneId String?
  createdById String
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone Milestone? @relation(fields: [milestoneId], references: [id])
  createdBy User       @relation("PlanCreator", fields: [createdById], references: [id])
  runs      TestRun[]
}

// F-07: per-project issue tracker connection. `authEnc` is an AES-256-GCM
// encrypted credentials JSON (lib/crypto) — it must NEVER leave the server:
// no serializer, no page prop, no audit detail. One row per provider.
model Integration {
  id        String   @id @default(cuid())
  projectId String
  provider  String // JIRA | GITHUB | GITLAB
  baseUrl   String // Jira site url / GitLab host; api.github.com for GITHUB
  targetKey String // Jira project key ("QA") | "owner/repo" | GitLab project path
  authEnc   String // encrypted {email, apiToken} (Jira) | {token}
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, provider])
}

// F-07: an issue in an external tracker, linked to a case or a run result.
// `status` is refreshed by the sync-issues cron; `syncedAt` gates staleness.
model IssueLink {
  id         String    @id @default(cuid())
  projectId  String
  provider   String
  issueKey   String // "QA-123" | "42"
  issueUrl   String
  title      String?
  status     String? // last synced status text
  syncedAt   DateTime?
  entityType String // CASE | RESULT
  entityId   String
  createdAt  DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
}

// F-08: push notifications to team chat / email. configJson holds the target:
// SLACK/DISCORD/TEAMS {webhookUrl} — stored AES-256-GCM encrypted (lib/crypto),
// EMAIL {to: string[]} — plain. Delivery is best-effort via lib/notifications.
model NotificationChannel {
  id         String   @id @default(cuid())
  projectId  String
  type       String // SLACK | DISCORD | TEAMS | EMAIL
  name       String // display label, e.g. "#qa-alerts"
  configJson String
  events     String // comma-separated, same vocabulary as WEBHOOK_EVENTS
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// F-05: immutable numbered snapshots of a case, one per meaningful change.
// snapshotJson holds every human-diffable field (steps stored EXPANDED via
// lib/steps so a snapshot survives later shared-group edits/deletes). Written
// only through recordRevision (src/lib/case-revisions.ts) — never updated.
model TestCaseRevision {
  id            String   @id @default(cuid())
  caseId        String
  rev           Int // 1,2,3… per case
  authorId      String?
  snapshotJson  String
  changeSummary String // comma list of changed field names, or "created" / "restored from rev N"
  createdAt     DateTime @default(now())

  testCase TestCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author   User?    @relation("RevisionAuthor", fields: [authorId], references: [id])

  @@unique([caseId, rev])
}

// F-03: admin-defined extra fields on test cases and run results. Values live
// on the entity itself (TestCase.customJson / TestRunResult.customJson) as a
// {key: value} object — no join table. Defs are soft-disabled via `active`,
// never hard-deleted once data exists, so old values keep rendering.
// F-14: per-project result-status definitions. The 7 built-in statuses become
// `system: true` rows (key & kind immutable, label/color editable, cannot be
// deactivated); teams add their own. Aggregate math keys off `kind`, never
// `key` — so a custom "Known Issue" (NEUTRAL) never skews the pass rate.
// A project with no rows uses the in-memory defaults (see lib/result-statuses);
// rows are seeded on the first edit, never on a read path.
model ResultStatusDef {
  id        String  @id @default(cuid())
  projectId String
  key       String // UPPER_SNAKE, immutable after create
  label     String
  color     String // hex, e.g. #a855f7
  kind      String // PASS | FAIL | NEUTRAL | BLOCKED
  order     Int     @default(0)
  active    Boolean @default(true)
  system    Boolean @default(false)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
}

model CustomFieldDef {
  id          String  @id @default(cuid())
  projectId   String
  entity      String  // "CASE" | "RESULT"
  key         String  // machine key ^[a-z][a-z0-9_]{1,30}$, unique per project+entity
  label       String
  type        String  // TEXT | TEXTAREA | NUMBER | CHECKBOX | DATE | URL | USER | DROPDOWN | MULTISELECT
  optionsJson String  @default("[]") // string[] for DROPDOWN/MULTISELECT
  required    Boolean @default(false)
  order       Int     @default(0)
  active      Boolean @default(true)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, entity, key])
}

// F-10: saved table filters ("views"). filtersJson holds a whitelisted subset
// of the cases-list URL params (suite/priority/type/q/tag). `shared` makes the
// view visible to every project member; `isDefault` (own views only, max one
// per user+project+entity) auto-applies when the list is opened without params.
model SavedView {
  id          String   @id @default(cuid())
  projectId   String
  userId      String // owner
  entity      String   @default("CASES") // CASES | RUNS (runs UI not wired yet)
  name        String
  filtersJson String
  shared      Boolean  @default(false)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, entity])
}

model ProjectMember {
  id        String @id @default(cuid())
  projectId String
  userId    String
  role      String @default("MEMBER") // OWNER | ADMIN | MEMBER | VIEWER

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

// Gap audit: entitas milestone dipakai PRD §4.3.1 & §9 (test_runs.milestone_id)
// tapi tidak ada di ERD — ditambahkan di sini.
model Milestone {
  id        String    @id @default(cuid())
  projectId String
  name      String
  dueDate   DateTime?
  status    String    @default("OPEN") // OPEN | COMPLETED

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runs    TestRun[]
  plans   TestPlan[]
}

model TestSuite {
  id          String  @id @default(cuid())
  projectId   String
  parentId    String? // hierarki rekursif: suite -> section
  name        String
  description String?
  order       Int     @default(0)

  project  Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   TestSuite?  @relation("SuiteTree", fields: [parentId], references: [id])
  children TestSuite[] @relation("SuiteTree")
  cases    TestCase[]
}

model TestCase {
  id               String    @id @default(cuid())
  projectId        String
  suiteId          String?
  seq              Int // nomor urut per project, display: TC-[SLUG]-[seq]
  order            Int       @default(0) // F-24: manual drag-reorder within a suite view; sort key is order,seq
  title            String
  description      String?
  preconditions    String?
  stepsJson        String    @default("[]") // [{action, expected}]
  expectedResult   String?
  priority         String    @default("MEDIUM") // CRITICAL | HIGH | MEDIUM | LOW
  type             String    @default("FUNCTIONAL") // FUNCTIONAL | REGRESSION | SMOKE | PERFORMANCE | SECURITY | E2E
  status           String    @default("ACTIVE") // DRAFT | ACTIVE | DEPRECATED
  automationStatus String    @default("NOT_AUTOMATED") // NOT_AUTOMATED | IN_PROGRESS | AUTOMATED | TO_BE_UPDATED
  tags             String    @default("") // comma-separated
  assigneeId       String?
  linkedIssues     String? // URL bug tracker, dipisah koma
  customJson       String    @default("{}") // F-03: {key: value} per CustomFieldDef CASE
  datasetJson      String    @default("[]") // F-13: [{name, values: {var: value}}] — {{var}} in title/steps/preconditions/expectedResult
  estimateSeconds  Int? // F-23: expected execution time; run/plan pages sum this into a total + forecast
  rev              Int       @default(1) // F-05: current revision number
  mutedAt          DateTime? // F-21: quarantined — excluded from pass-rate math everywhere
  mutedReason      String?
  mutedById        String?
  reviewerId       String? // F-15: assigned reviewer while status is IN_REVIEW (also who approved / requested changes)
  reviewedAt       DateTime? // F-15: when the reviewer approved or requested changes
  reviewNote       String? // F-15: the reviewer's "request changes" note
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime? // soft delete (gap audit: recycle bin)

  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  suite     TestSuite?         @relation(fields: [suiteId], references: [id], onDelete: SetNull)
  assignee  User?              @relation("CaseAssignee", fields: [assigneeId], references: [id])
  mutedBy   User?              @relation("CaseMutedBy", fields: [mutedById], references: [id])
  reviewer  User?              @relation("CaseReviewer", fields: [reviewerId], references: [id])
  results   TestRunResult[]
  revisions TestCaseRevision[]
  requirements RequirementCase[] // F-18
  baselineEntries BaselineEntry[] // F-28
  dependencies CaseDependency[] @relation("DependentCase") // F-32: cases THIS case depends on
  dependents   CaseDependency[] @relation("PrerequisiteCase") // F-32: cases that depend on THIS one

  @@unique([projectId, seq])
}

// F-32: `case` requires `dependsOn` to pass first. Cycle-checked at write
// time (DFS from dependsOn's own prerequisites, rejecting if it reaches
// `case` — see lib/case-dependencies.ts) since there's no cheap DB
// constraint for "no cycles in this edge set".
model CaseDependency {
  id              String   @id @default(cuid())
  caseId          String
  dependsOnCaseId String
  createdAt       DateTime @default(now())

  case      TestCase @relation("DependentCase", fields: [caseId], references: [id], onDelete: Cascade)
  dependsOn TestCase @relation("PrerequisiteCase", fields: [dependsOnCaseId], references: [id], onDelete: Cascade)

  @@unique([caseId, dependsOnCaseId])
}

model TestRun {
  id          String    @id @default(cuid())
  projectId   String
  name        String
  description String?
  status      String    @default("ACTIVE") // ACTIVE | COMPLETED
  source      String    @default("MANUAL") // MANUAL | JUNIT | CYPRESS | PLAYWRIGHT | ...
  origin      String? // where an automation run came from, e.g. "CI · GitHub Actions (Linux)" / "Local · macOS"
  milestoneId String?
  planId      String? // F-06: parent plan; null = standalone run (all pre-plan behavior)
  // F-06: {"Browser":"Chrome","OS":"Windows"} — option NAMES copied at creation,
  // not FK ids, so deleting a ConfigOption later never breaks an existing run.
  // This denormalization is deliberate.
  configJson    String?
  environmentId String? // F-19: which Environment this ran against; null = unset
  baselineId    String? // F-28: pins every result's caseRev to the baseline, not the case's current rev
  createdById   String
  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone   Milestone?      @relation(fields: [milestoneId], references: [id])
  plan        TestPlan?       @relation(fields: [planId], references: [id])
  environment Environment?    @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  baseline    SuiteBaseline?  @relation(fields: [baselineId], references: [id], onDelete: SetNull)
  createdBy   User            @relation("RunCreator", fields: [createdById], references: [id])
  results     TestRunResult[]
}

// F-28: a named snapshot of a suite tree + the case revisions (F-05) each
// case was at when captured — "compare baseline vs current" and "run from
// baseline" (pins TestRunResult.caseRev to the entry's rev instead of the
// case's current rev). No content is duplicated here: caseRev points at the
// existing TestCaseRevision, which already holds the full snapshot.
model SuiteBaseline {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  suiteId     String? // scope this baseline was created from; null = whole project
  createdById String
  createdAt   DateTime @default(now())

  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User            @relation("BaselineCreator", fields: [createdById], references: [id])
  entries   BaselineEntry[]
  runs      TestRun[]

  @@unique([projectId, name])
}

// One pinned case per baseline. suitePath is denormalized ("Auth > Login",
// "" = project root) at snapshot time so the tree survives a later suite
// rename/move/delete — comparing it to the case's current suite path is how
// "moved" is detected in the compare view.
model BaselineEntry {
  id         String @id @default(cuid())
  baselineId String
  caseId     String
  caseRev    Int
  suitePath  String

  baseline SuiteBaseline @relation(fields: [baselineId], references: [id], onDelete: Cascade)
  testCase TestCase      @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([baselineId, caseId])
}

// F-19: named environments a run can be tagged against (Staging, Prod, …).
// Deleting one just clears the tag on old runs (onDelete: SetNull) — unlike
// F-06 ConfigOption, there's no per-run name copy to keep, so an FK is fine.
model Environment {
  id        String   @id @default(cuid())
  projectId String
  name      String
  url       String?
  order     Int      @default(0)
  active    Boolean  @default(true)

  project Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runs    TestRun[]

  @@unique([projectId, name])
}

model TestRunResult {
  id             String   @id @default(cuid())
  runId          String
  caseId         String
  assigneeId     String?
  status         String   @default("UNTESTED") // PASSED | FAILED | BLOCKED | SKIPPED | IN_PROGRESS | UNTESTED | RETEST
  comment        String?
  elapsedSeconds Int?
  defectUrl      String?
  customJson     String   @default("{}") // F-03: {key: value} per CustomFieldDef RESULT
  caseRev        Int? // F-05: the case revision this result executed (null = pre-F-05)
  datasetName    String? // F-13: which dataset row this result executes; null = no parameters
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  run      TestRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  testCase TestCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  assignee User?    @relation("ResultAssignee", fields: [assigneeId], references: [id])

  // F-13: a case with N dataset rows seeds N results per run, one per row.
  @@unique([runId, caseId, datasetName])
}

// F-36 Part C: idempotency ledger for offline-queued result submissions. Each
// queued write carries a client-minted UUID (`clientId`); claiming it inside
// the write transaction means a double-flush (two tabs draining the same
// queue) applies once and fires side effects once. Grows one row per submit
// that carries a clientId (offline/mobile path only) — small and prunable.
model ResultSubmission {
  clientId  String   @id
  resultId  String
  userId    String
  createdAt DateTime @default(now())

  @@index([resultId])
}

// F-16: flat (non-threaded) comments on a case, run, or run result. bodyMd is
// Markdown (F-02 renderer); mentions are stored inline as `@[userId]` tokens.
// Soft delete keeps the row so the thread reads "deleted" instead of collapsing.
model Comment {
  id         String    @id @default(cuid())
  projectId  String
  entityType String // CASE | RUN | RESULT
  entityId   String
  authorId   String
  bodyMd     String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  editedAt   DateTime? // set on an author edit; drives the "edited" marker
  deletedAt  DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation("CommentAuthor", fields: [authorId], references: [id])

  @@index([projectId, entityType, entityId])
}

// Gap audit: PRD §5.3 mensyaratkan API key untuk CI/CD tapi tabelnya
// tidak ada di ERD §9 — ditambahkan, key disimpan sebagai hash (§5.5).
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  prefix     String // 8 char pertama, untuk identifikasi di UI
  keyHash    String    @unique
  scope      String    @default("WRITE") // READ (read-only) | WRITE (read + write)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  // F-33: project-scoped tokens. Null = org-wide (legacy v1 behaviour, key acts
  // across every project its owner belongs to). Set = the key may only touch
  // this one project; v2 rejects any other slug with 403 even if the owning
  // user is a member there.
  projectId String?

  // F-33: per-key rate limit (requests/minute). Null = fall back to the global
  // API_RATE_LIMIT default, so existing keys keep their current budget.
  rateLimitPerMin Int?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// PRD §12.2: organization/workspace dengan slug unik.
// Gap audit: entitas ini tidak ada di ERD §9 meski disyaratkan form register.
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  // F-29: AI assist (BYO key). Org-level config for an Anthropic-compatible
  // Messages endpoint. aiApiKeyEnc is AES-256-GCM encrypted (F-07 crypto) and
  // never leaves the server. All AI features degrade cleanly when unset.
  aiEndpoint  String? // base URL, e.g. https://api.anthropic.com (null = that default)
  aiModel     String? // e.g. claude-sonnet-5
  aiApiKeyEnc String? // encrypted API key; null = AI disabled

  users       User[]
  invitations Invitation[]
  roleDefs    RoleDef[]
}

// F-14: custom project-member roles. `name` is what ProjectMember.role stores
// (built-in OWNER/ADMIN/MEMBER/VIEWER stay as fixed presets and may not be
// redefined); permissionsJson is a JSON array of permission keys
// (see src/lib/permissions.ts PERMISSIONS).
model RoleDef {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  permissionsJson String   @default("[]")
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
}

// PRD §12.3/§12.5/§12.6.2: token verifikasi email & reset password (hash, expiry).
model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  type      String // VERIFY_EMAIL | RESET_PASSWORD
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// PRD §12.4 Step 2: undangan anggota tim dari onboarding wizard.
model Invitation {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  role           String   @default("MEMBER") // ADMIN | MEMBER
  status         String   @default("PENDING") // PENDING | ACCEPTED
  token          String?  @unique // dipakai di link accept /invite/[token]
  invitedById    String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation(fields: [invitedById], references: [id])

  @@unique([organizationId, email])
}

// A-05: persisted Academy lesson progress. Content lives in git
// (src/content/academy/**); only the slugs are stored here, so an edited or
// removed lesson never breaks an old row — see docs/QA-ACADEMY.md §3.
// Anonymous progress stays in localStorage (A-02) and is folded in once via
// claimAcademyProgress() on first authenticated load.
model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  trackSlug   String
  lessonSlug  String
  status      String    @default("DONE") // STARTED | DONE
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonSlug])
  @@index([userId, trackSlug])
}

// A-06: one row per *persisted* ISTQB practice-exam attempt — authed users
// only. Anonymous attempts are graded from a signed ticket (src/lib/academy/
// exam.ts) and never reach this table; see docs/QA-ACADEMY.md §2.4 and §3.
// Questions are NOT copied in: questionIdsJson + seed reproduce the exact
// paper from the git-versioned bank on demand, so an edited or withdrawn
// question never corrupts an old attempt's review view.
model ExamAttempt {
  id                String    @id @default(cuid())
  userId            String
  templateSlug      String // "ctfl-v4-full" | "ctfl-v4-ch1" | ...
  seed              String
  questionIdsJson   String    @default("[]")
  answersJson       String    @default("{}") // { [questionId]: string[] }
  startedAt         DateTime  @default(now())
  submittedAt       DateTime?
  durationSec       Int
  score             Int       @default(0) // correct answers
  total             Int
  passed            Boolean   @default(false)
  chapterScoresJson String    @default("{}") // { "1": {correct, total}, ... }
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A-10b: one attempt row per start ticket. `seed` is 16 random bytes minted
  // per ticket, so this makes replaying a ticket a constraint violation rather
  // than a second row — without a consumed-ticket table or any state to expire.
  // The hole it closes: an empty submission returns the full answer key (it is
  // the review screen), and the same ticket could then be re-submitted with
  // those answers to mint a `passed` attempt. See docs/QA-ACADEMY.md § A-10b.
  @@unique([userId, seed])
  @@index([userId, templateSlug])
}

// A-07: a shareable record of one achievement — a completed track, or a passing
// full practice exam. See docs/QA-ACADEMY.md § A-07.
//
// `serial` is HMAC-derived from (kind, refSlug, userId), so it is both
// unguessable (80 bits, no secret in the URL to reverse) and *deterministic*:
// issuing the same achievement twice computes the same serial, which the unique
// index turns into a no-op rather than a second certificate. That is the same
// trick `@@unique([userId, seed])` above plays for exam replays — make the
// duplicate unrepresentable instead of guarding against it in application code.
//
// `@@unique([userId, kind, refSlug])` is not redundant with it. The serial is
// derived once and *stored*, so lookups never recompute it and rotating
// AUTH_SECRET cannot break a link that is already out in the world — but a
// rotation would make the next derivation for the same achievement differ, and
// this constraint is what stops that from minting a second certificate.
//
// `revokedAt` is the holder's own visibility switch in this work order, not an
// integrity action: a set value makes /academy/certificate/<serial> a 404. See
// the A-07 entry for why an admin revocation would need a different signal.
model Certificate {
  id        String    @id @default(cuid())
  userId    String
  kind      String // TRACK | EXAM
  refSlug   String // track slug or exam template slug
  serial    String    @unique // HMAC-derived, unguessable, public URL segment
  scorePct  Int? // EXAM only: best passing score, null for TRACK
  // A-07c: the name printed on the certificate, frozen at issue rather than
  // resolved live from `User.name`. A credential that follows the account name
  // rewrites every copy already shared: a screenshot taken last month and the
  // page it links to would name two different people for one serial, and that
  // page resolving is the only thing that makes the serial checkable at all.
  // The holder may correct it — an OAuth display name is often a handle, not a
  // name — and the serial does not move when they do. Null means "issued before
  // this column existed"; those rows still resolve live from the account until
  // the backfill in prisma/seed.mjs reaches them.
  holderName String?
  issuedAt  DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, refSlug])
  @@index([userId])
}

// Gap audit: PRD §5.5 mensyaratkan audit log tapi tabelnya tidak ada di ERD.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String // case.create, run.complete, auth.login, dll
  entityType String?
  entityId   String?
  detail     String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}
