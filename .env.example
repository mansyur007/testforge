# Password statis, jadi minimal 24 karakter (atau pakai bcrypt hash).
# TF_SUPERADMIN_USER="superadmin"
# TF_SUPERADMIN_PASSWORD=""
# TF_SUPERADMIN_PASSWORD_HASH=""
